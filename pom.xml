<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.addy</groupId>
    <artifactId>simple-table</artifactId>
    <version>2.1.0</version>
    <packaging>jar</packaging>
    <description>Enhanced Java Swing table component and the associated model</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <distribution>repo</distribution>
            <url>https://www.apache.org/licenses/LICENSE-2.0.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>michelmbem</id>
            <name>Michel Mbem</name>
            <email>michel.mbem@gmail.com</email>
            <roles>
                <role>developer</role>
            </roles>
            <timezone>America/Toronto</timezone>
            <properties>
                <picUrl>https://avatars.githubusercontent.com/u/25884918?v=4</picUrl>
            </properties>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/michelmbem/simple-table.git</connection>
        <developerConnection>scm:git:https://github.com/michelmbem/simple-table.git</developerConnection>
        <url>https://github.com/michelmbem/simple-table</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>cloudsmith</id>
            <url>https://maven.cloudsmith.io/michelmbem/addy-libraries/</url>
        </snapshotRepository>
        <repository>
            <id>cloudsmith</id>
            <url>https://maven.cloudsmith.io/michelmbem/addy-libraries/</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>michelmbem-addy-libraries</id>
            <url>https://dl.cloudsmith.io/public/michelmbem/addy-libraries/maven/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.addy</groupId>
            <artifactId>addy-swing</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>de.odysseus.juel</groupId>
            <artifactId>juel-api</artifactId>
            <version>2.2.7</version>
        </dependency>
        <dependency>
            <groupId>de.odysseus.juel</groupId>
            <artifactId>juel-impl</artifactId>
            <version>2.2.7</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.7.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
	
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <mainClass>org.addy.simpletable.Demo</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
